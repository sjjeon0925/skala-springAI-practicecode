<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  3장 — Mapper XML.

  namespace 는 Mapper 인터페이스의 FQCN 과 정확히 같아야 하고,
  <select id="..."> 는 메서드 이름과 같아야 한다. 이 둘이 연결 고리다.

  이 파일의 자리는 application.yml 의  mybatis.mapper-locations  가 정한다.
-->
<mapper namespace="com.skala.ch02.mapper.OrderMapper">

    <!--
      재사용하는 컬럼 목록. as 로 붙인 별칭이 record 의 필드 이름과 같아서
      MyBatis 가 생성자에 그대로 꽂아 준다(arg-name-based-constructor-auto-mapping).
    -->
    <sql id="orderColumns">
        id          as orderId,
        item        as item,
        status      as status,
        ordered_at  as orderedAt,
        eta         as eta
    </sql>

    <!--
      동적 조건 검색.

      <where> 는 조건이 하나도 없으면 where 절 자체를 지우고,
      맨 앞의 and/or 도 알아서 떼어 준다 — 문자열을 이어 붙이던 시절의 버그가 사라진다.

      소유자 조건은 <if> 밖에 두었다. "조건에 따라 빠질 수 있는 자리"에 두면
      언젠가 반드시 빠진다 — 권한 조건은 항상 걸리는 자리에 둔다.
    -->
    <select id="search"
            parameterType="com.skala.ch02.dto.OrderDtos$OrderSearchCondition"
            resultType="com.skala.ch02.dto.OrderDtos$OrderRow">
        select
        <include refid="orderColumns"/>
        from orders
        <where>
            owner_id = #{ownerId}
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
            <if test="keyword != null and keyword != ''">
                and item like '%' || #{keyword} || '%'
            </if>
        </where>
        <!--
          정렬 컬럼은 SQL 에 문자열로 들어가는 자리다. 사용자 입력을 그대로 쓰면
          인젝션이 되므로, 허용된 값만 <choose> 로 매핑한다.
          (조건 객체에서 이미 화이트리스트로 한 번 걸렀고, 여기서 한 번 더 막는다)
        -->
        <choose>
            <when test="sort == 'eta'">order by eta asc</when>
            <when test="sort == 'item'">order by item asc</when>
            <otherwise>order by ordered_at desc</otherwise>
        </choose>
    </select>

    <!--
      집계 — 상태별 건수와 금액 합계.

      화면에 필요한 것은 숫자 몇 개인데, 엔티티를 전부 꺼내 자바에서 세면
      건수가 늘어난 날 그대로 장애가 된다. 세는 일은 DB 가 제일 잘한다.

      case 로 코드값을 화면 문구까지 만들어 주었다 — 이렇게 SQL 한 번으로
      끝나는 종류의 일이 Mapper 를 쓰는 이유다.
    -->
    <!--
      cast(status as varchar) 가 붙은 이유 — JPA 와 표를 나눠 쓸 때 실제로 겪는 마찰이다.

      이 표는 JPA 가 만들었고, @Enumerated(STRING) 필드는 H2 에서 ENUM 타입 컬럼이 된다.
      그래서 case 의 결과 타입이 ENUM 으로 추론되고, '배송완료' 같은 값은 허용되지 않는다며 실패한다.
      문자열로 명시해 주면 해결된다. 스키마를 누가 만드는지가 SQL 에 영향을 준다는 예다.
    -->
    <select id="statistics" resultType="com.skala.ch02.dto.OrderDtos$OrderStatistic">
        select cast(status as varchar) as status,
               case cast(status as varchar)
                   when 'PAID'      then '결제완료'
                   when 'PREPARING' then '상품준비중'
                   when 'SHIPPING'  then '배송중'
                   when 'DELIVERED' then '배송완료'
                   else cast(status as varchar)
               end                as statusLabel,
               count(*)           as count,
               sum(cost)          as totalCost
          from orders
         where owner_id = #{ownerId}
         group by status
         order by count(*) desc
    </select>

</mapper>
