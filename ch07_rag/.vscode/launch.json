    {
      "type": "java",
      "name": "ch07_rag (.env)",
      "request": "launch",
      "mainClass": "com.skala.ch07.Ch07Application",
      "projectName": "ch07_rag",
      "vmArgs": "-Dfile.encoding=UTF-8",
      "envFile": "${workspaceFolder}/.env"
